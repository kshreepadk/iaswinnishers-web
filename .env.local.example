# Copy this file to .env.local and fill in your real values.
# .env.local is already in .gitignore — it will never be committed or
# pushed to GitHub, which is important since these are secret keys.

# Found in your Supabase project: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin dashboard (/admin/leads) — a shared password for you/your coaches.
# Pick anything reasonably strong; this is the password used to log in.
ADMIN_PASSWORD=choose-a-strong-password-here

# A long random string used to sign login sessions — NOT a password anyone
# types in. Any random 32+ character string works. One easy way to generate
# one: run `openssl rand -hex 32` in a terminal, or use any password
# generator and paste the result here.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
