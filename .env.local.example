# Copy this file to .env.local and fill in your real values.
# .env.local is already in .gitignore — it will never be committed or
# pushed to GitHub, which is important since these are secret keys.

# Found in your Supabase project: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin dashboard (/admin/leads) — a shared password for you/your coaches.
# Pick anything reasonably strong; this is the password used to log in.
ADMIN_PASSWORD=choose-a-strong-password-here

# A long random string used to sign login sessions — NOT a password anyone
# types in. Any random 32+ character string works. One easy way to generate
# one: run `openssl rand -hex 32` in a terminal, or use any password
# generator and paste the result here.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Found in your Resend account: API Keys. Used only to send the short
# "thanks for downloading" follow-up email after someone requests a free
# resource — the download itself doesn't depend on this at all.
RESEND_API_KEY=re_your_key_here

# WhatsApp notification to YOU whenever anyone submits any form on the
# site. See the README's "WhatsApp notifications" section for how to get
# both of these from CallMeBot — it only takes sending one WhatsApp
# message yourself, no account signup.
WHATSAPP_NOTIFY_PHONE=919886273325
WHATSAPP_APIKEY=your-callmebot-apikey-here

# Optional — a second person to also notify (e.g. a co-founder or coach).
# Leave both blank/unset if you only want one recipient. This person needs
# their own CallMeBot key from their own phone (see README) — a key from
# recipient 1 will NOT work here.
WHATSAPP_NOTIFY_PHONE_2=
WHATSAPP_APIKEY_2=
