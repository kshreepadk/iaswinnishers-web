# Copy this file to .env.local and fill in your real values.
# .env.local is already in .gitignore — it will never be committed or
# pushed to GitHub, which is important since these are secret keys.

# Found in your Supabase project: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Found in your Resend account: API Keys
RESEND_API_KEY=re_your_key_here

# Your live site's URL — used to build working download links inside emails.
# Locally this can stay as localhost; in Vercel's Environment Variables,
# set it to your real domain (or your .vercel.app URL until you connect one).
SITE_URL=http://localhost:3000
